class CustomDialog(simpledialog.Dialog):
    def __init__(self, parent, title=None, fields=None, special_fields=None):
        self.fields = fields or []
        self.special_fields = special_fields or {}
        self.widgets = []
        super().__init__(parent, title)
    def body(self, master):
        for i, field_name in enumerate(self.fields):
            ttk.Label(master, text=f"{field_name}:", font=("Inter", 11)).grid(row=i, column=0, sticky="w", padx=5, pady=8)
            widget = None
            if field_name in self.special_fields:
                spec = self.special_fields[field_name]
                if spec['type'] == 'combobox':
                    widget = ttk.Combobox(master, values=spec['options'], width=28, state="readonly", font=("Inter", 11))
                    widget.set(spec['options'][0])
            if widget is None:
                widget = tk.Entry(master, width=30, font=("Inter", 11), relief="flat", highlightthickness=1, bd=1, bg="#f8fbff", highlightbackground="#bdd1ee")
            widget.grid(row=i, column=1, padx=5, pady=8, sticky="ew")
            self.widgets.append(widget)
        return self.widgets[0]
    def apply(self):
        self.result = [widget.get() for widget in self.widgets]

class ReportWindow(tk.Toplevel):
    def __init__(self, parent, app_data):
        super().__init__(parent)
        self.title("Expense Report")
        self.geometry("640x520")
        GradientFrame(self, "#e0eafc", "#cfdef3").pack(fill="both", expand=True)
        card = CardFrame(self)
        card.place(relx=0.5, rely=0.5, anchor="center", width=580, height=440)
        expenses = [t for t in app_data['transactions'] if t['type'] == 'expense']
        if not expenses:
            ttk.Label(card, text="No expense data to display.", font=LABEL_FONT).pack(pady=50)
            return
        expenses_by_category = {}
        for t in expenses:
            expenses_by_category[t['category']] = expenses_by_category.get(t['category'], 0) + t['amount']
        labels = list(expenses_by_category.keys())
        sizes = list(expenses_by_category.values())
        chart_colors = ['#457b9d', '#43aa8b', '#e63946', '#f1faee', '#a8dadc', '#f7e0e0', '#8ac6d0', '#ffe082']
        fig = Figure(figsize=(6, 5), dpi=100)
        ax = fig.add_subplot(111)
        wedges, texts, autotexts = ax.pie(
            sizes, labels=labels, autopct='%1.1f%%', startangle=90, shadow=True, colors=chart_colors,
            textprops={'fontsize': 12, 'fontfamily': 'Inter'}
        )
        ax.set_title("Expenses by Category", fontdict={'fontsize': 16, 'fontweight': 'bold', 'fontfamily': 'Inter'})
        ax.axis('equal')
        fig.tight_layout()
        canvas = FigureCanvasTkAgg(fig, master=card)
        canvas.draw()
        canvas.get_tk_widget().pack(side=tk.TOP, fill=tk.BOTH, expand=True, padx=10, pady=10)

