def load_data():
    if not os.path.exists(DATA_FILE):
        save_data({"transactions": [], "goals": []})
        return {"transactions": [], "goals": []}
    with open(DATA_FILE, 'r') as f:
        try:
            data = json.load(f)
            if "transactions" not in data:
                data["transactions"] = []
            if "goals" not in data:
                data["goals"] = []
            return data
        except json.JSONDecodeError:
            return {"transactions": [], "goals": []}

def save_data(data):
    with open(DATA_FILE, 'w') as f:
        json.dump(data, f, indent=4)

# --- Gradient Canvas Helper ---
class GradientFrame(tk.Canvas):
    def __init__(self, parent, color1, color2, **kwargs):
        super().__init__(parent, **kwargs)
        self.color1, self.color2 = color1, color2
        self.bind("<Configure>", self._draw_gradient)
    def _draw_gradient(self, event=None):
        self.delete("gradient")
        width = self.winfo_width()
        height = self.winfo_height()
        limit = height
        (r1, g1, b1) = self.winfo_rgb(self.color1)
        (r2, g2, b2) = self.winfo_rgb(self.color2)
        r_ratio = float(r2 - r1) / limit
        g_ratio = float(g2 - g1) / limit
        b_ratio = float(b2 - b1) / limit
        for i in range(limit):
            nr = int(r1 + (r_ratio * i))
            ng = int(g1 + (g_ratio * i))
            nb = int(b1 + (b_ratio * i))
            color = "#%04x%04x%04x" % (nr, ng, nb)
            self.create_line(0, i, width, i, tags=("gradient",), fill=color)
        self.lower("gradient")

# --- Modern Rounded Button ---
class ModernButton(tk.Canvas):
    def __init__(self, parent, text, command, bg=PRIMARY_ACCENT, fg="#fff", font=("Inter", 12, "bold"), radius=18, **kwargs):
        super().__init__(parent, highlightthickness=0, bd=0, **kwargs)
        self.radius = radius
        self.bg = bg
        self.fg = fg
        self.font = font
        self.command = command
        self.text = text
        self.configure(height=40, width=160, bg=self.bg)
        self.button_id = self.create_rounded_rect(2, 2, 158, 38, self.radius, fill=self.bg, outline="")
        self.text_id = self.create_text(80, 20, text=self.text, fill=self.fg, font=self.font)
        self.bind("<Button-1>", lambda e: self.command())
        self.bind("<Enter>", self.on_enter)
        self.bind("<Leave>", self.on_leave)
        self.bind_tags()
    def create_rounded_rect(self, x1, y1, x2, y2, r, **kwargs):
        points = [
            x1+r, y1,
            x2-r, y1,
            x2, y1, x2, y1+r,
            x2, y2-r,
            x2, y2, x2-r, y2,
            x1+r, y2,
            x1, y2, x1, y2-r,
            x1, y1+r,
            x1, y1
        ]
        return self.create_polygon(points, smooth=True, **kwargs)
    def on_enter(self, event=None):
        self.itemconfig(self.button_id, fill=BUTTON_HOVER_COLOR)
    def on_leave(self, event=None):
        self.itemconfig(self.button_id, fill=self.bg)
    def bind_tags(self):
        self.tag_bind(self.button_id, "<Button-1>", lambda e: self.command())
        self.tag_bind(self.text_id, "<Button-1>", lambda e: self.command())
        self.tag_bind(self.button_id, "<Enter>", self.on_enter)
        self.tag_bind(self.text_id, "<Enter>", self.on_enter)
        self.tag_bind(self.button_id, "<Leave>", self.on_leave)
        self.tag_bind(self.text_id, "<Leave>", self.on_leave)

