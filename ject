    def update_all_views(self):
        self._update_summary_display()
        self._update_transaction_list()
        self._update_goal_list()
    def _update_summary_display(self):
        transactions = self.app_data.get("transactions", [])
        total_income = sum(t['amount'] for t in transactions if t['type'] == 'income')
        total_expenses = sum(t['amount'] for t in transactions if t['type'] == 'expense')
        remaining_budget = total_income - total_expenses
        self.income_label.config(text=f"${total_income:,.2f}")
        self.expense_label.config(text=f"${total_expenses:,.2f}")
        self.remaining_label.config(text=f"${remaining_budget:,.2f}")
        if remaining_budget < 0:
            self.remaining_label.config(foreground=DANGER_COLOR)
        else:
            self.remaining_label.config(foreground=PRIMARY_ACCENT)
    def _update_transaction_list(self):
        for i in self.transaction_tree.get_children():
            self.transaction_tree.delete(i)
        sorted_transactions = sorted(self.app_data["transactions"], key=lambda x: x['id'], reverse=True)
        for t in sorted_transactions:
            amount_str = f"${t['amount']:,.2f}"
            values = (t['id'], t['date'], t['type'].capitalize(), t['category'], amount_str)
            self.transaction_tree.insert("", "end", values=values)
    def _update_goal_list(self):
        for i in self.goal_tree.get_children():
            self.goal_tree.delete(i)
        sorted_goals = sorted(self.app_data["goals"], key=lambda x: x['id'], reverse=True)
        for goal in sorted_goals:
            target_str = f"${goal['target_amount']:,.2f}"
            values = (goal['id'], goal['category'], target_str)
            self.goal_tree.insert("", "end", values=values)

    def add_transaction_dialog(self, transaction_type):
        title = f"Add {transaction_type.capitalize()}"
        special_fields = {}
        if transaction_type == 'expense':
            special_fields['Category'] = {'type': 'combobox', 'options': EXPENSE_CATEGORIES}
        dialog = CustomDialog(self, title=title, fields=["Amount ($)", "Category"], special_fields=special_fields)
        if not dialog.result: return
        try:
            amount_str, category = dialog.result
            amount = float(amount_str)
            if category == "Other...":
                category = simpledialog.askstring("Custom Category", "Please enter the category name:", parent=self)
                if not category:
                    return
            if amount <= 0 or not category.strip():
                messagebox.showerror("Invalid Input", "Please enter a positive amount and a non-empty category.")
                return
            transaction = {
                "id": datetime.now().timestamp(), "type": transaction_type, "amount": amount,
                "category": category, "date": datetime.now().strftime("%Y-%m-%d")
            }
            self.app_data["transactions"].append(transaction)
            save_data(self.app_data)
            self.update_all_views()
            messagebox.showinfo("Success", f"{transaction_type.capitalize()} added successfully!")
        except (ValueError, TypeError):
            messagebox.showerror("Error", "Invalid amount. Please enter a number.")

    def set_goal_dialog(self):
        dialog = CustomDialog(self, title="Set a New Goal", fields=["Goal Category", "Target Amount ($)"])
        if not dialog.result: return
        try:
            category, target_amount_str = dialog.result
            target_amount = float(target_amount_str)
            if target_amount <= 0 or not category.strip():
                messagebox.showerror("Invalid Input", "Please enter a positive amount and a non-empty category.")
                return
            goal = {"id": datetime.now().timestamp(), "category": category, "target_amount": target_amount}
            self.app_data["goals"].append(goal)
            save_data(self.app_data)
            self.update_all_views()
            messagebox.showinfo("Success", f"Goal for '{category}' set!")
        except (ValueError, TypeError):
            messagebox.showerror("Error", "Invalid amount. Please enter a number.")

    def delete_selected_transaction(self):
        selected_item = self.transaction_tree.selection()
        if not selected_item:
            messagebox.showwarning("No Selection", "Please select a transaction to delete.")
            return
        if not messagebox.askyesno("Confirm Deletion", "Are you sure you want to delete this transaction?"):
            return
        item_id = float(self.transaction_tree.item(selected_item, "values")[0])
        self.app_data["transactions"] = [t for t in self.app_data["transactions"] if t['id'] != item_id]
        save_data(self.app_data)
        self.update_all_views()
        messagebox.showinfo("Success", "Transaction deleted.")

    def delete_selected_goal(self):
        selected_item = self.goal_tree.selection()
        if not selected_item:
            messagebox.showwarning("No Selection", "Please select a goal to delete.")
            return
        if not messagebox.askyesno("Confirm Deletion", "Are you sure you want to delete this goal?"):
            return
        item_id = float(self.goal_tree.item(selected_item, "values")[0])
        self.app_data["goals"] = [g for g in self.app_data["goals"] if g['id'] != item_id]
        save_data(self.app_data)
        self.update_all_views()
        messagebox.showinfo("Success", "Goal deleted.")

